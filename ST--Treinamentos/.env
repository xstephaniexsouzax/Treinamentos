# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" NUNCA deve ser commitado (confira o .gitignore).
#
# Variáveis VITE_* -> vão para o bundle do navegador (front-end). Não são secretas de verdade.
# Variáveis SEM prefixo VITE_ -> só existem no servidor (Serverless Functions em /api).
#                                Essas SIM ficam realmente escondidas do usuário final.

# ---- Front-end (Vite) ----

# Chaves do Web3Forms (uma por produto, para rotear o e-mail certo)
VITE_WEB3FORMS_KEY_TELEBRAS= 6f74ad80-593d-4925-ad16-e93607b12874
VITE_WEB3FORMS_KEY_DPE= d8429bf7-bce8-4f4c-87d7-58f591eb4b67
VITE_WEB3FORMS_KEY_DETRAN=

# Chave da API do ImgBB (upload de prints de erro)
VITE_IMGBB_API_KEY= 6396d23a9e3bfae117ece1723ab8cb8a

# ---- Back-end (Serverless Functions da Vercel, pasta /api) ----

# Login da tela de Gestão — validado no servidor em /api/login.js.
# Configure estas variáveis no painel da Vercel (Project Settings > Environment Variables),
# NUNCA com prefixo VITE_, ou elas vazam para o bundle público.
GESTAO_USUARIO=gestao
GESTAO_SENHA=

# Chave secreta usada para assinar o token de sessão emitido após o login.
# Gere um valor longo e aleatório, por exemplo com: openssl rand -hex 32
AUTH_SECRET= 9f3a7c82d4e1b6a0f5c9e8d2174a6b3f8c1d5e9a7b2f0c6d4e8a1f9b3c7d2e5
